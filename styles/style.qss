* {
    font-family: "Segoe UI", "Microsoft YaHei UI", Tahoma, sans-serif;
}

QWidget#loginRoot {
    background-color: #0f172a;
}

QWidget#loginCard {
    background-color: #ffffff;
    border-radius: 14px;
}

QLabel#tituloApp {
    font-size: 24px;
    font-weight: 700;
    color: #0f172a;
}

QLabel#subtituloApp {
    font-size: 12px;
    color: #64748b;
}

QLabel#labelCampo {
    font-size: 12px;
    font-weight: 600;
    color: #334155;
    margin-bottom: 4px;
}

QLineEdit {
    background-color: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 13px;
    color: #0f172a;
    selection-background-color: #3b82f6;
}

QLineEdit:focus {
    border: 1px solid #3b82f6;
    background-color: #ffffff;
}

QPushButton#btnLogin {
    background-color: #2563eb;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 10px 20px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#btnLogin:hover {
    background-color: #1d4ed8;
}

QPushButton#btnLogin:pressed {
    background-color: #1e40af;
}

QPushButton#btnLogin:disabled {
    background-color: #93c5fd;
    color: #ffffff;
}

QLabel#lblMensaje {
    font-size: 12px;
    padding: 6px 10px;
    border-radius: 6px;
}

QLabel#lblMensaje[estado="error"] {
    background-color: #fef2f2;
    color: #b91c1c;
    border: 1px solid #fecaca;
}

QLabel#lblMensaje[estado="info"] {
    background-color: #eff6ff;
    color: #1d4ed8;
    border: 1px solid #bfdbfe;
}

QLabel#lblMensaje[estado="ok"] {
    background-color: #f0fdf4;
    color: #15803d;
    border: 1px solid #bbf7d0;
}

QLabel#estadoConexion {
    font-size: 11px;
    color: #94a3b8;
}

QFrame#headerBar {
    background-color: #1e293b;
}

QFrame#sideBar {
    background-color: #ffffff;
    border-right: 1px solid #e2e8f0;
}

QFrame#contentArea {
    background-color: #f1f5f9;
}

QLabel#userInfoNombre {
    font-size: 14px;
    font-weight: 600;
    color: #0f172a;
}

QLabel#userInfoRol {
    font-size: 11px;
    color: #64748b;
}

QPushButton#menuBtn {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    padding: 8px 12px;
    text-align: left;
    font-size: 13px;
    color: #475569;
}

QPushButton#menuBtn:hover {
    background-color: #f1f5f9;
    color: #0f172a;
}

QPushButton#menuBtn:checked {
    background-color: #eff6ff;
    color: #1d4ed8;
    border-left: 3px solid #2563eb;
}

QFrame#card {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
}

QLabel#cardTitle {
    font-size: 12px;
    font-weight: 600;
    color: #64748b;
}

QLabel#cardValue {
    font-size: 22px;
    font-weight: 700;
    color: #0f172a;
}

QLabel#seccionTitulo {
    font-size: 18px;
    font-weight: 700;
    color: #0f172a;
}

QLabel#headerTitulo {
    font-size: 15px;
    font-weight: 600;
    color: #ffffff;
}

QLabel#headerSubtitulo {
    font-size: 11px;
    color: #94a3b8;
}

QPushButton#btnHeader {
    background-color: rgba(255, 255, 255, 0.08);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 12px;
}

QPushButton#btnHeader:hover {
    background-color: rgba(255, 255, 255, 0.15);
}

QPushButton#avatarBtn {
    background-color: transparent;
    border: none;
    border-radius: 16px;
}

QPushButton#avatarBtn:hover {
    background-color: rgba(255, 255, 255, 0.1);
}

QLabel#avatarLbl {
    color: #ffffff;
    font-weight: 700;
    font-size: 13px;
}

QPushButton#btnCerrar {
    background-color: #ef4444;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#btnCerrar:hover {
    background-color: #dc2626;
}
